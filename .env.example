# AYRA — example settings file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL. AYRA runs with no settings file at all: the
# brain uses your Claude login, and voice falls back to the browser's speech.
#
# To change something: copy this file to .env.local (same folder), then
# uncomment and edit only the lines you need. .env.local is gitignored —
# never commit a real key.
#
# Two programs read .env.local:
#   - the BRIDGE (the brain, bridge/server.mjs) reads AYRA_* and ELEVENLABS_API_KEY
#   - the FACE (the Vite web app) reads VITE_* — and only VITE_* values ever
#     reach the browser, so never put a secret in a VITE_ variable.
#
# Who AYRA is (name, wake words, honorific, language, voice gender) is NOT set
# here — that lives in config/identity.json.


# ===================================================================
# BRIDGE (the brain)
# ===================================================================

# Model for the brain. Default claude-opus-5-5 (smartest).
# claude-sonnet-5-5 answers faster and uses less of your Claude plan.
# AYRA_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Default medium.
# AYRA_EFFORT=medium

# Port the brain listens on (WebSocket + HTTP). Default 8787.
# If you change it, change VITE_BRIDGE_URL below to match.
# AYRA_BRIDGE_PORT=8787

# Allow effectful tools (shell, writing files, clicking/typing in Chrome,
# sending). Off by default. `npm run bridge:writes` turns it on for one run.
# Read decideTool() in bridge/server.mjs first.
# AYRA_ALLOW_WRITES=0

# Extra web-page origins allowed to talk to the brain, comma separated.
# Local dev addresses (localhost:5173-5199, 4173-4199) are already allowed.
# AYRA_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (scripts, native apps).
# Off by default, because that is also what local malware looks like.
# AYRA_ALLOW_NO_ORIGIN=0

# Extra folders the /file endpoint may show images from, comma separated.
# Your home folder and the temp folder are always included.
# AYRA_FILE_ROOTS=

# ElevenLabs voice id for the premium voice. Default: George.
# AYRA_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# 1 = print every message from the Claude Agent SDK (troubleshooting).
# AYRA_DEBUG=0

# ElevenLabs API key (optional): premium voice + speech-to-text.
# Free tier is enough to try it. If your elevenlabs MCP server in
# ~/.claude.json already has a key, the bridge finds it there too.
# ELEVENLABS_API_KEY=


# ===================================================================
# FACE (the web app)
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge — the local brain above (recommended; no API key)
#   direct — the browser calls the Claude API itself; needs VITE_ANTHROPIC_API_KEY
# VITE_BACKEND=bridge

# Where the brain listens. Keep the port in step with AYRA_BRIDGE_PORT.
# VITE_BRIDGE_URL=ws://localhost:8787

# Speech engine when no ElevenLabs voice is active. Default system.
#   system — the browser's own voices (instant). Edge has the best ones.
#   kokoro — a neural voice running in the browser (better, slower to start)
# VITE_TTS_ENGINE=system

# Kokoro voice. Default follows the voice gender in config/identity.json
# (bf_emma for female, bm_george for male). Options: bf_emma, bf_isabella,
# bf_alice, bf_lily, af_heart, af_bella, bm_george, bm_fable, bm_lewis, bm_daniel
# VITE_KOKORO_VOICE=bf_emma

# Prefer the ElevenLabs voice from the browser when a key is available.
# VITE_USE_ELEVENLABS=false

# Anthropic API key — DIRECT MODE ONLY. It ships to the browser, so use it
# only for a local demo. The default bridge mode never reads it.
# VITE_ANTHROPIC_API_KEY=
